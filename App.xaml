
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FitnessTracker"
             xmlns:converters="clr-namespace:FitnessTracker.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FitnessTracker.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dodajemy nasz globalny konwerter! -->
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"
                                                TrueColor="#2B3A42"
                                                FalseColor="Transparent" />

            <!-- Używany w wielu widokach: pokazuje element tylko gdy tekst nie jest pusty -->
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>