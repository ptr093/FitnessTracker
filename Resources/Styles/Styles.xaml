<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Globalne style aplikacji. Kolory pochodzą z Resources/Themes (Light/Dark) przez DynamicResource,
    więc wszystko przełącza się razem z motywem.

    Skala czcionek: Display 28 · Title 22 · Headline 18 · Body 14 · Caption 12 · Overline 11
    Zaokrąglenia:   karty 18 · kafelki wewnątrz kart 14 · pola i przyciski 12
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =========================================================
         DOMYŚLNE STYLE KONTROLEK
         ========================================================= -->

    <Style TargetType="ContentPage"
           ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource PageBackground}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryButton}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButton}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <!-- Wyłączony przycisk: przezroczystość zamiast koloru, żeby działało dla każdego tła -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Placeholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Placeholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Placeholder}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Blue}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Green}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Surface}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Blue}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Blue}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Blue}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Blue}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource SurfaceStrong}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Blue}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Border}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource Border}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource SurfaceStrong}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Hero}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource OnHero}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource OnHero}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <!-- Nagłówek rysuje każda strona sama (Controls/PageHeader) -->
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <!-- =========================================================
         TYPOGRAFIA
         ========================================================= -->

    <Style x:Key="TextDisplay" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="TextTitle" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="TextHeadline" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="TextBody" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style x:Key="TextCaption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Etykieta nad polem formularza, np. "PARTIA MIĘŚNIOWA" -->
    <Style x:Key="TextOverline" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="0.6" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- =========================================================
         KARTY I POLA
         ========================================================= -->

    <!-- Biała karta sekcji -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Kafelek wewnątrz karty (np. statystyka) -->
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMuted}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Ramka wokół Entry / Picker -->
    <Style x:Key="InputFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMuted}" />
        <Setter Property="Stroke" Value="{DynamicResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- =========================================================
         PRZYCISKI
         ========================================================= -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButton}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryButton}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource BlueSoft}" />
        <Setter Property="TextColor" Value="{DynamicResource Blue}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource RedSoft}" />
        <Setter Property="TextColor" Value="{DynamicResource Red}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Blue}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- =========================================================
         IKONY (czcionka Material Symbols)
         ========================================================= -->

    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialSymbols" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
