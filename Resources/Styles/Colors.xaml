<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Stałe kolory marki (nie zależą od motywu). Kolory zależne od motywu są w Resources/Themes.
    Na Androidzie zob. też Platforms/Android/Resources/values/colors.xml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#0F172A</Color>
    <Color x:Key="Accent">#22C55E</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

</ResourceDictionary>
