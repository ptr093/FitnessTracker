<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Jasny motyw. Każdy kolor ma odpowiednik o tej samej nazwie w DarkTheme.xaml.
    Widoki używają ich przez {DynamicResource Nazwa}, więc zmiana motywu działa od razu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="FitnessTracker.Resources.Themes.LightTheme">

    <!-- Powierzchnie -->
    <Color x:Key="PageBackground">#F1F5F9</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F8FAFC</Color>
    <Color x:Key="SurfaceStrong">#E2E8F0</Color>
    <Color x:Key="Border">#E2E8F0</Color>
    <Color x:Key="BorderStrong">#CBD5E1</Color>
    <Color x:Key="Shadow">#0F172A</Color>

    <!-- Tekst -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#334155</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="Placeholder">#94A3B8</Color>

    <!-- Nagłówki (ciemne w obu motywach) -->
    <Color x:Key="Hero">#0F172A</Color>
    <Color x:Key="HeroRaised">#1E293B</Color>
    <Color x:Key="HeroRun">#064E3B</Color>
    <Color x:Key="OnHero">#FFFFFF</Color>
    <Color x:Key="OnHeroMuted">#CBD5E1</Color>
    <Color x:Key="OnHeroSubtle">#94A3B8</Color>

    <!-- Przyciski -->
    <Color x:Key="PrimaryButton">#0F172A</Color>
    <Color x:Key="OnPrimaryButton">#FFFFFF</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>

    <!-- Akcenty -->
    <Color x:Key="Blue">#2563EB</Color>
    <Color x:Key="BlueSoft">#EFF6FF</Color>
    <Color x:Key="BlueBorder">#BFDBFE</Color>

    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="GreenBright">#22C55E</Color>
    <Color x:Key="OnGreenBright">#052E16</Color>
    <Color x:Key="GreenSoft">#ECFDF5</Color>
    <Color x:Key="GreenBorder">#A7F3D0</Color>
    <Color x:Key="GreenText">#166534</Color>

    <Color x:Key="Teal">#0F766E</Color>
    <Color x:Key="TealStrong">#0F766E</Color>
    <Color x:Key="TealSoft">#F0FDFA</Color>
    <Color x:Key="TealBorder">#99F6E4</Color>
    <Color x:Key="TealText">#115E59</Color>

    <Color x:Key="Orange">#EA580C</Color>
    <Color x:Key="OrangeOnHero">#FDBA74</Color>
    <Color x:Key="OrangeSoft">#FFF7ED</Color>
    <Color x:Key="OrangeBorder">#FED7AA</Color>
    <Color x:Key="OrangeText">#9A3412</Color>

    <Color x:Key="Red">#DC2626</Color>
    <Color x:Key="RedSoft">#FEF2F2</Color>
    <Color x:Key="RedBorder">#FECACA</Color>

    <Color x:Key="Indigo">#4F46E5</Color>
    <Color x:Key="IndigoStrong">#4F46E5</Color>
    <Color x:Key="IndigoSoft">#EEF2FF</Color>
    <Color x:Key="IndigoBorder">#C7D2FE</Color>
    <Color x:Key="IndigoText">#3730A3</Color>

    <Color x:Key="Gold">#FACC15</Color>

    <!-- Odznaki (historia, rekordy) i wykres -->
    <Color x:Key="BlueBadge">#DBEAFE</Color>
    <Color x:Key="BlueBadgeText">#1D4ED8</Color>
    <Color x:Key="GreenBadge">#DCFCE7</Color>
    <Color x:Key="GreenBadgeText">#15803D</Color>
    <Color x:Key="IndigoBadge">#E0E7FF</Color>
    <Color x:Key="IndigoBadgeText">#4338CA</Color>
    <Color x:Key="OrangeBadgeText">#C2410C</Color>
    <Color x:Key="AmberBadge">#FEF3C7</Color>
    <Color x:Key="AmberBadgeText">#B45309</Color>
    <Color x:Key="PinkBadge">#FCE7F3</Color>
    <Color x:Key="PinkBadgeText">#BE185D</Color>
    <Color x:Key="Amber">#F59E0B</Color>
    <Color x:Key="AmberText">#92400E</Color>
</ResourceDictionary>
