<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="FitnessTracker.Views.NewPersonalRecordPopup"
    Color="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border StrokeShape="RoundRectangle 18"
            BackgroundColor="{DynamicResource Surface}"
            WidthRequest="360"
            Padding="0">

        <VerticalStackLayout Spacing="0">
            <Grid BackgroundColor="{DynamicResource Hero}" Padding="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BackgroundColor="{DynamicResource Gold}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        Padding="10"
                        HeightRequest="44"
                        WidthRequest="44"
                        VerticalOptions="Center">
                    <Label Text="&#xea23;"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="#0F172A" FontFamily="MaterialSymbols" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     Margin="12,0,0,0"
                                     VerticalOptions="Center">
                    <Label Text="Nowy rekord!"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource OnHero}" />
                    <Label Text="Świetna robota"
                           FontSize="13"
                           TextColor="{DynamicResource OnHeroMuted}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="18" Spacing="14">
                <Label x:Name="ExerciseLabel"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       LineBreakMode="TailTruncation" />

                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource SurfaceMuted}"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="1"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Poprzedni rekord"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label x:Name="OldRecordLabel"
                                   Grid.Column="1"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSecondary}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nowy rekord"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label x:Name="NewRecordLabel"
                                   Grid.Column="1"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Green}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                    <Label Text="&#xebcc;"
                           FontSize="14"
                           VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                    <Label x:Name="DateLabel"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           VerticalOptions="Center" />
                </Grid>

                <Button Text="Super!"
                        Clicked="OnCloseClicked"
                        BackgroundColor="{DynamicResource PrimaryButton}"
                        TextColor="{DynamicResource OnPrimaryButton}"
                        CornerRadius="12"
                        HeightRequest="50" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>