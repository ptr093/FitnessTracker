<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.HistoryPage"
             Title="Historia">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}">

        <ScrollView>
            <VerticalStackLayout Padding="15,20"
                                 Spacing="18"
                                 MaximumWidthRequest="720"
                                 HorizontalOptions="Fill">

                <controls:PageHeader Title="Historia treningów"
                                     Subtitle="Przeglądaj i edytuj zapisane treningi." />

                <!-- DNI TRENINGOWE -->
                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource Surface}"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Shadow}"
                                Offset="0,4"
                                Radius="10"
                                Opacity="0.08" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="20"
                                         Spacing="14">

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="&#xebcc;"
                                   FontSize="18"
                                   VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="Kalendarz treningów"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Wybierz dzień, aby zobaczyć szczegóły"
                               FontSize="13"
                               TextColor="{DynamicResource TextMuted}" />

                        <ScrollView Orientation="Horizontal">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TrainingDays}"
                                                   Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 14"
                                                BackgroundColor="{Binding BackgroundColor}"
                                                StrokeThickness="0"
                                                Padding="0"
                                                WidthRequest="68"
                                                HeightRequest="68">
                                            <Button Text="{Binding DayLabel}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectDayCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{Binding TextColor}"
                                                    CornerRadius="12"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="WordWrap" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                    </VerticalStackLayout>
                </Border>

                <!-- LISTA TRENINGÓW -->
                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource Surface}"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="{DynamicResource Shadow}"
                                Offset="0,4"
                                Radius="10"
                                Opacity="0.08" />
                    </Border.Shadow>

                    <VerticalStackLayout Padding="20"
                                         Spacing="14">

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="&#xea19;"
                                       FontSize="18"
                                       VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding SelectedDayTitle}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,6">
                                <Label Text="{Binding SelectedDayWorkoutsCount, StringFormat='{}{0} treningów'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredWorkouts}"
                                             Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <toolkit:Expander>
                                        <toolkit:Expander.Header>
                                            <Border StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                                    Stroke="{DynamicResource Border}"
                                                    StrokeThickness="1"
                                                    Padding="16">

                                                <VerticalStackLayout Spacing="12">

                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="12">

                                                        <VerticalStackLayout Grid.Column="0"
                                                                             Spacing="4">
                                                            <Label Text="{Binding HeaderTitle}"
                                                                   FontSize="18"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{DynamicResource TextPrimary}" />

                                                            <Label Text="{Binding HeaderSubtitle}"
                                                                   FontSize="13"
                                                                   TextColor="{DynamicResource TextMuted}" />
                                                        </VerticalStackLayout>

                                                        <Border Grid.Column="1"
                                                                BackgroundColor="{Binding BadgeBackground}"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 12"
                                                                Padding="10,6"
                                                                VerticalOptions="Start">
                                                            <Label Text="{Binding BadgeText}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{Binding BadgeTextColor}" />
                                                        </Border>
                                                    </Grid>

                                                    <HorizontalStackLayout Spacing="10">

                                                        <Button Text="Edytuj"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditWorkoutCommand}"
                                                                CommandParameter="{Binding .}"
                                                                BackgroundColor="{DynamicResource BlueSoft}"
                                                                TextColor="{DynamicResource Blue}"
                                                                FontAttributes="Bold"
                                                                CornerRadius="12"
                                                                HeightRequest="40"
                                                                Padding="14,0" />

                                                        <Button Text="Usuń"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteWorkoutCommand}"
                                                                CommandParameter="{Binding .}"
                                                                BackgroundColor="{DynamicResource RedSoft}"
                                                                TextColor="{DynamicResource Red}"
                                                                FontAttributes="Bold"
                                                                CornerRadius="12"
                                                                HeightRequest="40"
                                                                Padding="14,0" />

                                                    </HorizontalStackLayout>

                                                </VerticalStackLayout>
                                            </Border>
                                        </toolkit:Expander.Header>

                                        <Border StrokeShape="RoundRectangle 14"
                                                BackgroundColor="{DynamicResource Surface}"
                                                Stroke="{DynamicResource Border}"
                                                StrokeThickness="1"
                                                Padding="14"
                                                Margin="0,8,0,0">

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DetailLines}"
                                                                 Spacing="8">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border StrokeShape="RoundRectangle 12"
                                                                BackgroundColor="{DynamicResource SurfaceMuted}"
                                                                StrokeThickness="0"
                                                                Padding="12,10">
                                                            <Label Text="{Binding .}"
                                                                   FontSize="14"
                                                                   TextColor="{DynamicResource TextSecondary}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                        </Border>
                                    </toolkit:Expander>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                             Padding="16"
                                             Spacing="8">
                            <Label Text="Brak treningów w tym dniu"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Wybierz inny dzień albo dodaj nowy trening."
                                   FontSize="13"
                                   TextColor="{DynamicResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- TOOLKIT: WSKAZÓWKA -->
                <toolkit:Expander>
                    <toolkit:Expander.Header>
                        <Border StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource OrangeSoft}"
                                Stroke="{DynamicResource OrangeBorder}"
                                StrokeThickness="1"
                                Padding="16">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="&#xe0f0;"
                                       FontSize="18"
                                       VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="Wskazówka"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource OrangeText}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </toolkit:Expander.Header>

                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource OrangeBorder}"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,8,0,0">
                        <Label Text="Z poziomu historii możesz szybko poprawić błędny trening, usunąć go"
                               FontSize="14"
                               TextColor="{DynamicResource OrangeText}" />
                    </Border>
                </toolkit:Expander>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>