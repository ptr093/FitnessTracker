<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.RecordsPage"
             Title="Rekordy">

    <ScrollView>
        <VerticalStackLayout Padding="15,20,15,30"
                             Spacing="16"
                             MaximumWidthRequest="620"
                             HorizontalOptions="Fill">

            <controls:PageHeader Title="Rekordy"
                                 Subtitle="{Binding SelectedHeader}" />

            <!-- Przyciski nawigacyjne (widoczne tylko, gdy jesteśmy głębiej) -->
            <Grid ColumnDefinitions="*,*" 
                  ColumnSpacing="12"
                  IsVisible="{Binding CanGoBack}">

                <Button Text="‹ Wróć"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{DynamicResource Surface}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderStrong}"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontAttributes="Bold" />

                <Button Grid.Column="1"
                        Text="Od nowa"
                        Command="{Binding ResetSelectionCommand}"
                        BackgroundColor="{DynamicResource SurfaceMuted}"
                        TextColor="{DynamicResource TextMuted}"
                        BorderColor="{DynamicResource Border}"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontAttributes="Bold" />
            </Grid>

            <!-- 1. KATEGORIE GŁÓWNE -->
            <!-- Dodałem IsVisible, żeby znikały po wybraniu -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}"
                                 IsVisible="{Binding ShowMainCategories}"
                                 Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 18"
                                BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}"
                                StrokeThickness="1"
                                Padding="20">

                            <Border.Shadow>
                                <Shadow Brush="{DynamicResource Shadow}"
                                        Offset="0,5"
                                        Radius="8"
                                        Opacity="0.05" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="18">

                                <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Icon}"
                                           FontSize="32" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{Binding TextColor}" />

                                    <Label Text="{Binding Subtitle}"
                                           FontSize="14"
                                           TextColor="{Binding TextColor}"
                                           Opacity="0.75" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="&#xe5cc;"
                                       FontSize="30"
                                       TextColor="{Binding TextColor}"
                                       Opacity="0.4"
                                       VerticalOptions="Center" FontFamily="MaterialSymbols" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- 2. PARTIE SIŁOWE -->
            <VerticalStackLayout IsVisible="{Binding ShowStrengthCategories}"
                                 Spacing="10">
                <Label Text="Wybierz partię"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding StrengthCategories}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeThickness="1"
                                    Padding="18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectStrengthCategoryCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{Binding TextColor}" />
                                    <Label Text="{Binding Subtitle}"
                                           FontSize="13"
                                           TextColor="{Binding TextColor}"
                                           Opacity="0.75" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- 3. ĆWICZENIA -->
            <VerticalStackLayout IsVisible="{Binding ShowExercises}"
                                 Spacing="10">
                <Label Text="Wybierz ćwiczenie"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeThickness="1"
                                    Padding="18">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectExerciseCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{Binding TextColor}" />
                                    <Label Text="{Binding Subtitle}"
                                           FontSize="13"
                                           TextColor="{Binding TextColor}"
                                           Opacity="0.75" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- 4. REKORDY -->
            <CollectionView ItemsSource="{Binding Records}"
                            SelectionMode="None"
                            IsVisible="{Binding ShowRecords}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 18"
                                BackgroundColor="{DynamicResource Surface}"
                                StrokeThickness="0"
                                Padding="18"
                                Margin="0,0,0,12">
                            <Border.Shadow>
                                <Shadow Brush="{DynamicResource Shadow}"
                                        Offset="0,5"
                                        Radius="10"
                                        Opacity="0.08" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">

                                    <Border BackgroundColor="{Binding AccentBackground}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding Icon}"
                                               FontSize="18" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />

                                        <Label Text="{Binding Subtitle}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            BackgroundColor="{Binding BadgeBackground}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10,6"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding Category}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding BadgeTextColor}" />
                                    </Border>
                                </Grid>

                                <Border StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{DynamicResource SurfaceMuted}"
                                        Stroke="{DynamicResource Border}"
                                        StrokeThickness="1"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding ValueText}"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />

                                        <Label Text="{Binding DetailText}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <Border BackgroundColor="{DynamicResource SurfaceMuted}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Data"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextMuted}" />
                                            <Label Text="{Binding DateText}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="{DynamicResource SurfaceMuted}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Szczegóły"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextMuted}" />
                                            <Label Text="{Binding ExtraText}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextSecondary}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- EMPTY STATE -->
            <Border IsVisible="{Binding ShowEmptyState}"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0"
                    Padding="24">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,5"
                            Radius="10"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Brak danych"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Dla tego wyboru nie ma jeszcze zapisanych rekordów."
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>