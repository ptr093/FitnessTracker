<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.EditWorkoutTemplatePage"
             Title="Edytuj szablon">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15,20,15,30"
                                 Spacing="16"
                                 MaximumWidthRequest="620"
                                 HorizontalOptions="Fill">

                <controls:PageHeader Title="Szablon treningu"
                                     Subtitle="Dodaj ćwiczenia i liczbę serii. Przy starcie podpowiemy dane z ostatniego treningu."
                                     BackgroundKey="TealStrong" />

                <Border Padding="16"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="SZCZEGÓŁY SZABLONU"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}" />

                        <Entry Text="{Binding TemplateName, Mode=TwoWay}"
                               Placeholder="np. Trening klaty"
                               TextColor="{DynamicResource TextPrimary}"
                               PlaceholderColor="{DynamicResource Placeholder}"
                               BackgroundColor="{DynamicResource SurfaceMuted}"
                               HeightRequest="48" />

                        <Entry Text="{Binding Description, Mode=TwoWay}"
                               Placeholder="Opis opcjonalny, np. poniedziałek"
                               TextColor="{DynamicResource TextPrimary}"
                               PlaceholderColor="{DynamicResource Placeholder}"
                               BackgroundColor="{DynamicResource SurfaceMuted}"
                               HeightRequest="48" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="DODAJ ĆWICZENIE"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}" />

                        <Picker ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource SurfaceMuted}"
                                HeightRequest="48" />

                        <Picker ItemsSource="{Binding AvailableExercises}"
                                SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource SurfaceMuted}"
                                HeightRequest="48" />

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              HeightRequest="46">

                            <Button Text="−"
                                    Command="{Binding DecreaseSetCountCommand}"
                                    BackgroundColor="{DynamicResource SurfaceStrong}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    WidthRequest="52"
                                    Padding="0" />

                            <Label Grid.Column="1"
                                   Text="{Binding SelectedSetCount, StringFormat='Liczba serii: {0}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextSecondary}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />

                            <Button Grid.Column="2"
                                    Text="+"
                                    Command="{Binding IncreaseSetCountCommand}"
                                    BackgroundColor="{DynamicResource SurfaceStrong}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    WidthRequest="52"
                                    Padding="0" />
                        </Grid>

                        <Button Text="+ Dodaj ćwiczenie"
                                Command="{Binding AddExerciseCommand}"
                                BackgroundColor="{DynamicResource BlueSoft}"
                                TextColor="{DynamicResource Blue}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="ĆWICZENIA W SZABLONIE"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextMuted}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        BackgroundColor="{DynamicResource Surface}"
                                        Stroke="{DynamicResource Border}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="3">
                                            <Label Text="{Binding Exercise}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Category}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextMuted}" />
                                            <Label Text="{Binding SetCount, StringFormat='Serie: {0}'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource Teal}" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Usuń"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveExerciseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{DynamicResource RedSoft}"
                                                TextColor="{DynamicResource Red}"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="40"
                                                Padding="12,0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Border}"
                StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
                <Button Text="Anuluj"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{DynamicResource SurfaceStrong}"
                        TextColor="{DynamicResource TextPrimary}"
                        CornerRadius="12"
                        HeightRequest="48"
                        Padding="16,0" />
                <Button Grid.Column="1"
                        Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{DynamicResource TealStrong}"
                        TextColor="{DynamicResource OnHero}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
