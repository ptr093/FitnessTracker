<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessTracker.Views.EditWorkoutTemplatePage"
             Title="Edytuj szablon"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15,20,15,30"
                                 Spacing="16"
                                 MaximumWidthRequest="620"
                                 HorizontalOptions="Center">

                <Border Padding="18"
                        BackgroundColor="#0F766E"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Szablon treningu"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Dodaj ćwiczenia i określ liczbę serii. Przy rozpoczęciu podpowiemy dane z ostatniego treningu."
                               FontSize="13"
                               TextColor="#CCFBF1"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="SZCZEGÓŁY SZABLONU"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#64748B" />

                        <Entry Text="{Binding TemplateName, Mode=TwoWay}"
                               Placeholder="np. Trening klaty"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="48" />

                        <Entry Text="{Binding Description, Mode=TwoWay}"
                               Placeholder="Opis opcjonalny, np. poniedziałek"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="48" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="DODAJ ĆWICZENIE"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#64748B" />

                        <Picker ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                TextColor="#0F172A"
                                BackgroundColor="#F8FAFC"
                                HeightRequest="48" />

                        <Picker ItemsSource="{Binding AvailableExercises}"
                                SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                                TextColor="#0F172A"
                                BackgroundColor="#F8FAFC"
                                HeightRequest="48" />

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              HeightRequest="46">

                            <Button Text="−"
                                    Command="{Binding DecreaseSetCountCommand}"
                                    BackgroundColor="#E2E8F0"
                                    TextColor="#0F172A"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    WidthRequest="52"
                                    Padding="0" />

                            <Label Grid.Column="1"
                                   Text="{Binding SelectedSetCount, StringFormat='Liczba serii: {0}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />

                            <Button Grid.Column="2"
                                    Text="+"
                                    Command="{Binding IncreaseSetCountCommand}"
                                    BackgroundColor="#E2E8F0"
                                    TextColor="#0F172A"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    WidthRequest="52"
                                    Padding="0" />
                        </Grid>

                        <Button Text="+ Dodaj ćwiczenie"
                                Command="{Binding AddExerciseCommand}"
                                BackgroundColor="#EFF6FF"
                                TextColor="#2563EB"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="ĆWICZENIA W SZABLONIE"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#64748B" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="3">
                                            <Label Text="{Binding Exercise}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Category}"
                                                   FontSize="12"
                                                   TextColor="#64748B" />
                                            <Label Text="{Binding SetCount, StringFormat='Serie: {0}'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F766E" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Usuń"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveExerciseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFF1F2"
                                                TextColor="#E11D48"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="40"
                                                Padding="12,0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
                <Button Text="Anuluj"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="12"
                        HeightRequest="48"
                        Padding="16,0" />
                <Button Grid.Column="1"
                        Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#0F766E"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
