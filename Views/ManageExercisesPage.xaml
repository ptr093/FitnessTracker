<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.ManageExercisesPage"
             Title="Moje ćwiczenia">

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="0"
          MaximumWidthRequest="620">

        <controls:PageHeader Grid.Row="0"
                             Margin="15,20,15,12"
                             Title="Moje ćwiczenia"
                             Subtitle="Edytuj lub usuń własne ćwiczenia. Zapisane treningi zostają w historii." />

        <!-- FILTR PARTII -->
        <VerticalStackLayout Grid.Row="1"
                             Margin="15,0,15,16"
                             Spacing="6">

            <Label Text="PARTIA MIĘŚNIOWA"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextMuted}" />

            <Border HeightRequest="58"
                    Padding="12,0"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                <Picker ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        Title="Wybierz partię"
                        TextColor="{DynamicResource TextPrimary}"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent" />
            </Border>
        </VerticalStackLayout>

        <!-- LISTA ĆWICZEŃ -->
        <CollectionView Grid.Row="2"
                        Margin="15,0,15,20"
                        ItemsSource="{Binding VisibleExercises}"
                        SelectionMode="None"
                        VerticalOptions="Fill">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label Text="Brak własnych ćwiczeń"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Dodaj własne ćwiczenie podczas rejestracji treningu siłowego."
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="12"
                            MinimumHeightRequest="64"
                            BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center">

                            <Label Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />

                            <Button Grid.Column="1"
                                    Text="Edytuj"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                      Path=BindingContext.EditExerciseCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{DynamicResource BlueSoft}"
                                    TextColor="{DynamicResource Blue}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="14,0" />

                            <Button Grid.Column="2"
                                    Text="Usuń"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                      Path=BindingContext.DeleteExerciseCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{DynamicResource RedSoft}"
                                    TextColor="{DynamicResource Red}"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    Padding="14,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>