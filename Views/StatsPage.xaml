<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.StatsPage"
             Title="Analityka">

    <ScrollView>
        <VerticalStackLayout Padding="15,20,15,30"
                             Spacing="16"
                             MaximumWidthRequest="620"
                             HorizontalOptions="Fill">

            <controls:PageHeader Title="Analityka i Wilks"
                                 Subtitle="Oblicz BMI i oszacuj swój wynik Wilksa." />

            <!-- 1. TWOJE DANE -->
            <Border StrokeShape="RoundRectangle 18" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}" Offset="0,5" Radius="10" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Wymiary ciała" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Waga (kg)" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            <Entry Keyboard="Numeric" 
                                   Text="{Binding Weight}" 
                                   BackgroundColor="{DynamicResource SurfaceMuted}"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Wzrost (cm)" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            <Entry Keyboard="Numeric" 
                                   Text="{Binding Height}" 
                                   BackgroundColor="{DynamicResource SurfaceMuted}"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Spacing="10"
                       VerticalOptions="Center">
                       
                        <Label Text="Płeć"
                       VerticalOptions="Center"
                       FontSize="14"
                       TextColor="{DynamicResource TextPrimary}"
                       WidthRequest="70" />

                        <Picker Title="Wybierz płeć"
                        ItemsSource="{Binding GenderOptions}"
                        SelectedItem="{Binding SelectedGender}"
                        BackgroundColor="{DynamicResource SurfaceMuted}"
                        TextColor="{DynamicResource TextPrimary}"></Picker>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 2. BMI -->
            <Border StrokeShape="RoundRectangle 18" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}" Offset="0,5" Radius="10" Opacity="0.08" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Kalkulator BMI" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                        <Label Text="{Binding BmiCategory}" FontSize="14" TextColor="{Binding BmiColor}" FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <Label Grid.Column="1" Text="{Binding Bmi, StringFormat='{0:0.##}'}" FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- 3. RĘCZNE WPROWADZANIE DO WILKSA -->
            <Border StrokeShape="RoundRectangle 18" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}" Offset="0,5" Radius="10" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Kalkulator Wilksa (Maks. ciężar)" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="Wpisz podniesiony ciężar oraz liczbę powtórzeń. Aplikacja automatycznie oszacuje Twój wynik na 1 powtórzenie (1RM) i wyliczy punkty." 
                           FontSize="12" TextColor="{DynamicResource TextMuted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ciężar (kg)" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                            <Entry Keyboard="Numeric" 
                                   Text="{Binding LiftedWeight}" 
                                   BackgroundColor="{DynamicResource SurfaceMuted}"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Powtórzenia" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                            <Entry Keyboard="Numeric" 
                                   Text="{Binding Reps}" 
                                   BackgroundColor="{DynamicResource SurfaceMuted}"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 4. WYNIK WILKSA -->
            <Border StrokeShape="RoundRectangle 18" BackgroundColor="{DynamicResource Hero}" StrokeThickness="0" Padding="20">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}" Offset="0,5" Radius="10" Opacity="0.2" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*,*">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Szacowany 1RM (Maks)" FontSize="12" TextColor="{DynamicResource OnHeroMuted}" />
                        <Label Text="{Binding EstimatedOneRepMax, StringFormat='{0:0.##} kg'}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource OnHero}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                        <Label Text="Punkty Wilksa" FontSize="12" TextColor="{DynamicResource OnHeroMuted}" HorizontalOptions="End" />
                        <Label Text="{Binding WilksScore, StringFormat='{0:0.##}'}" FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource OrangeOnHero}" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>