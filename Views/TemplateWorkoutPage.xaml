<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.TemplateWorkoutPage"
             Title="Trening z szablonu">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15,20,15,30"
                                 Spacing="16"
                                 MaximumWidthRequest="620"
                                 HorizontalOptions="Fill">

                <controls:PageHeader Title="{Binding TemplateName}"
                                     Subtitle="Wartości z ostatniego treningu – zmień je lub pomiń ćwiczenie."
                                     BackgroundKey="TealStrong" />

                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Border}"
                        StrokeThickness="1"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="SZCZEGÓŁY TRENINGU"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}" />

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Data"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="1"
                                    Padding="10,0">
                                <DatePicker Date="{Binding WorkoutDate, Mode=TwoWay}"
                                            Format="dd MMM yyyy"
                                            MinimumDate="2000-01-01"
                                            MaximumDate="2100-12-31"
                                            TextColor="{DynamicResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            HeightRequest="46" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Lokalizacja (opcjonalnie)"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="1"
                                    Padding="10,0">
                                <Entry Text="{Binding Location, Mode=TwoWay}"
                                       Placeholder="np. CityFit Warszawa, dom"
                                       PlaceholderColor="{DynamicResource Placeholder}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       BackgroundColor="Transparent"
                                       HeightRequest="46"
                                       ClearButtonVisibility="WhileEditing" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- LISTA ĆWICZEŃ -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}"
                                     Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="1"
                                    Padding="16">
                                <VerticalStackLayout Spacing="12">

                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="3">
                                            <Label Text="{Binding Exercise}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Category}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="+ Seria"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddSetCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{DynamicResource BlueSoft}"
                                                TextColor="{DynamicResource Blue}"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="38"
                                                Padding="12,0" />

                                        <Button Grid.Column="2"
                                                Text="Pomiń"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveExerciseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{DynamicResource RedSoft}"
                                                TextColor="{DynamicResource Red}"
                                                FontAttributes="Bold"
                                                CornerRadius="10"
                                                HeightRequest="38"
                                                Padding="12,0" />
                                    </Grid>

                                    <Grid ColumnDefinitions="42,*,*,42"
                                          ColumnSpacing="8">
                                        <Label Text="SET"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextMuted}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1"
                                               Text="KG"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextMuted}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="2"
                                               Text="POWT."
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextMuted}"
                                               HorizontalTextAlignment="Center" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                                         Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="42,*,*,42"
                                                      ColumnSpacing="8">
                                                    <Border StrokeShape="RoundRectangle 10"
                                                            BackgroundColor="{DynamicResource SurfaceStrong}"
                                                            StrokeThickness="0"
                                                            HeightRequest="42">
                                                        <Label Text="{Binding SetNumber}"
                                                               FontAttributes="Bold"
                                                               TextColor="{DynamicResource TextSecondary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>

                                                    <Border Grid.Column="1"
                                                            StrokeShape="RoundRectangle 10"
                                                            BackgroundColor="{DynamicResource SurfaceMuted}"
                                                            Stroke="{DynamicResource BorderStrong}"
                                                            StrokeThickness="1"
                                                            Padding="8,0">
                                                        <Entry Text="{Binding Weight, Mode=TwoWay}"
                                                               Keyboard="Numeric"
                                                               HorizontalTextAlignment="Center"
                                                               TextColor="{DynamicResource TextPrimary}"
                                                               FontAttributes="Bold"
                                                               BackgroundColor="Transparent"
                                                               HeightRequest="42" />
                                                    </Border>

                                                    <Border Grid.Column="2"
                                                            StrokeShape="RoundRectangle 10"
                                                            BackgroundColor="{DynamicResource SurfaceMuted}"
                                                            Stroke="{DynamicResource BorderStrong}"
                                                            StrokeThickness="1"
                                                            Padding="8,0">
                                                        <Entry Text="{Binding Reps, Mode=TwoWay}"
                                                               Keyboard="Numeric"
                                                               HorizontalTextAlignment="Center"
                                                               TextColor="{DynamicResource TextPrimary}"
                                                               FontAttributes="Bold"
                                                               BackgroundColor="Transparent"
                                                               HeightRequest="42" />
                                                    </Border>

                                                    <Button Grid.Column="3"
                                                            Text="&#xe5cd;"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSetCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{DynamicResource RedSoft}"
                                                            TextColor="{DynamicResource Red}"
                                                            FontAttributes="Bold"
                                                            FontSize="16"
                                                            CornerRadius="10"
                                                            HeightRequest="42"
                                                            WidthRequest="42"
                                                            Padding="0" FontFamily="MaterialSymbols" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- WIDOCZNE TYLKO, GDY KOLEKCJA JEST PUSTA -->
                <VerticalStackLayout IsVisible="{Binding IsExercisesEmpty}"
                                     Spacing="8"
                                     Padding="20"
                                     HorizontalOptions="Center">
                    <Label Text="Brak ćwiczeń w tym treningu"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Wróć do listy szablonów i uruchom trening ponownie."
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource Border}"
                StrokeThickness="1"
                Padding="15">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">
                <Button Text="Anuluj"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{DynamicResource SurfaceStrong}"
                        TextColor="{DynamicResource TextPrimary}"
                        CornerRadius="12"
                        HeightRequest="50"
                        Padding="18,0" />

                <Button Grid.Column="1"
                        Text="Zapisz trening"
                        Command="{Binding SaveWorkoutCommand}"
                        BackgroundColor="{DynamicResource TealStrong}"
                        TextColor="{DynamicResource OnHero}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
