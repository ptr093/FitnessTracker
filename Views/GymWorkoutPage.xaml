<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.GymWorkoutPage"
             Title="Trening siłowy">

    <ScrollView>
        <VerticalStackLayout Padding="15,20"
                             Spacing="18"
                             MaximumWidthRequest="620"
                             HorizontalOptions="Fill">

            <controls:PageHeader Title="Trening siłowy"
                                 Subtitle="Wybierz partię i ćwiczenie, wpisz serie." />

            <!-- KARTA: SZCZEGÓŁY -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Padding="20"
                                     Spacing="16">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xe8e1;"
                               FontSize="18"
                               VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Szczegóły ćwiczenia"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- WYBÓR PARTII -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Partia mięśniowa"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               FontAttributes="Bold"
                               TextTransform="Uppercase" />

                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource SurfaceMuted}"
                                Stroke="{DynamicResource Border}"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Picker ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- WYBÓR ĆWICZENIA LUB DODANIE WŁASNEGO -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Rodzaj ćwiczenia"
                               FontSize="12"
                               TextColor="{DynamicResource TextMuted}"
                               FontAttributes="Bold"
                               TextTransform="Uppercase" />

                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource SurfaceMuted}"
                                Stroke="{DynamicResource Border}"
                                StrokeThickness="1"
                                Padding="12,0">
                            <Picker ItemsSource="{Binding AvailableExercises}"
                                    SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- POBIERZ DANE Z OSTATNIEGO TRENINGU -->
                    <VerticalStackLayout Spacing="8"
                                         IsVisible="{Binding HasSelectedCategory}">
                        <Button Text="⟲  Pobierz z ostatniego treningu"
                                Command="{Binding LoadLastWorkoutCommand}"
                                IsEnabled="{Binding IsNotLoadingLastWorkout}"
                                BackgroundColor="{DynamicResource GreenSoft}"
                                TextColor="{DynamicResource GreenText}"
                                BorderColor="{DynamicResource GreenBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="46" />

                        <Label Text="{Binding LastWorkoutInfo}"
                               IsVisible="{Binding LastWorkoutInfo, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                               FontSize="12"
                               TextColor="{DynamicResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- KARTA: PROGRESJA -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource IndigoSoft}"
                    Stroke="{DynamicResource IndigoBorder}"
                    StrokeThickness="1"
                    Padding="18"
                    IsVisible="{Binding HasProgressionInfo}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xe8e5;"
                               FontSize="18"
                               VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Podpowiedź progresji"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource IndigoText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding ProgressionDetails}"
                           IsVisible="{Binding ProgressionDetails, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                           FontSize="12"
                           TextColor="{DynamicResource Indigo}" />

                    <Label Text="{Binding ProgressionInfo}"
                           FontSize="14"
                           TextColor="{DynamicResource IndigoText}" />

                    <Button Text="Zastosuj sugestię"
                            Command="{Binding ApplySuggestionCommand}"
                            IsVisible="{Binding CanApplySuggestion}"
                            BackgroundColor="{DynamicResource IndigoStrong}"
                            TextColor="{DynamicResource OnHero}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="42" />
                </VerticalStackLayout>
            </Border>

            <!-- LOKALIZACJA -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Lokalizacja (opcjonalnie)"
           FontSize="12"
           TextColor="{DynamicResource TextMuted}"
           FontAttributes="Bold"
           TextTransform="Uppercase" />

                <Border StrokeShape="RoundRectangle 12"
            BackgroundColor="{DynamicResource SurfaceMuted}"
            Stroke="{DynamicResource Border}"
            StrokeThickness="1"
            Padding="12,0">
                    <Entry Text="{Binding Location, Mode=TwoWay}"
               Placeholder="np. CityFit Warszawa, dom"
               TextColor="{DynamicResource TextPrimary}"
               PlaceholderColor="{DynamicResource Placeholder}"
               BackgroundColor="Transparent"
               HeightRequest="48"
               ClearButtonVisibility="WhileEditing" />
                </Border>
            </VerticalStackLayout>

            <!-- KARTA: SERIE -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Padding="20"
                                     Spacing="14">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xeb43;"
                               FontSize="18"
                               VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Serie"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- NAGŁÓWKI TABELI SERII -->
                    <!-- Margines = padding (10) + obramowanie (1) wiersza, żeby kolumny pokrywały się z polami -->
                    <Grid ColumnDefinitions="44,*,*,50"
                          ColumnSpacing="8"
                          Margin="11,0,11,4">
                        <Label Grid.Column="0"
                               Text="SET"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="1"
                               Text="KG"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="2"
                               Text="REPS"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />
                    </Grid>

                    <!-- LISTA SERII -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{DynamicResource SurfaceMuted}"
                                        Stroke="{DynamicResource Border}"
                                        StrokeThickness="1"
                                        Padding="10">
                                    <Grid ColumnDefinitions="44,*,*,50"
                                          ColumnSpacing="8">

                                        <!-- NUMER SERII -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource SurfaceStrong}"
                                                StrokeThickness="0"
                                                HeightRequest="42"
                                                WidthRequest="42"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SetNumber}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- CIĘŻAR (KG) -->
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Surface}"
                                                Stroke="{DynamicResource BorderStrong}"
                                                StrokeThickness="1">
                                            <Entry Text="{Binding Weight}"
                                                   Keyboard="Numeric"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   FontAttributes="Bold"
                                                   BackgroundColor="Transparent"
                                                   HeightRequest="42" />
                                        </Border>

                                        <!-- POWTÓRZENIA -->
                                        <Border Grid.Column="2"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Surface}"
                                                Stroke="{DynamicResource BorderStrong}"
                                                StrokeThickness="1">
                                            <Entry Text="{Binding Reps}"
                                                   Keyboard="Numeric"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   FontAttributes="Bold"
                                                   BackgroundColor="Transparent"
                                                   HeightRequest="42" />
                                        </Border>

                                        <!-- PRZYCISK USUWANIA -->
                                        <Border Grid.Column="3"
                                                BackgroundColor="{DynamicResource RedSoft}"
                                                Stroke="{DynamicResource RedBorder}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="1"
                                                HeightRequest="42"
                                                WidthRequest="42"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Button Text="&#xe5cd;"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Red}"
                                                    BackgroundColor="Transparent"
                                                    Padding="0"
                                                    CornerRadius="10"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSetCommand}"
                                                    CommandParameter="{Binding .}" FontFamily="MaterialSymbols" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- PRZYCISK: DODAJ SERIĘ -->
                    <Button Text="+ Dodaj serię"
                            Command="{Binding AddSetCommand}"
                            BackgroundColor="{DynamicResource BlueSoft}"
                            TextColor="{DynamicResource Blue}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46"
                            Margin="0,6,0,0" />

                    <!-- MINUTNIK PRZERWY -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource Hero}"
                            StrokeThickness="0"
                            Padding="14"
                            Margin="0,6,0,0">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2"
                                                     VerticalOptions="Center">
                                    <Label
                                           FontSize="12"
                                           TextColor="{DynamicResource OnHeroSubtle}"
                                           FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="&#xe425;" FontFamily="MaterialSymbols" />
                                                <Span Text="  Przerwa" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding RestRemainingText}"
                                           FontSize="26"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource OnHero}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="{Binding RestButtonText}"
                                        Command="{Binding ToggleRestCommand}"
                                        BackgroundColor="{DynamicResource GreenBright}"
                                        TextColor="{DynamicResource OnGreenBright}"
                                        FontAttributes="Bold"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        Padding="16,0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <ProgressBar Progress="{Binding RestProgress}"
                                         ProgressColor="{DynamicResource GreenBright}" />

                            <HorizontalStackLayout Spacing="8"
                                                   BindableLayout.ItemsSource="{Binding RestPresets}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding ., StringFormat='{0}s'}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectRestCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{DynamicResource HeroRaised}"
                                                TextColor="{DynamicResource OnHeroMuted}"
                                                FontSize="12"
                                                CornerRadius="10"
                                                HeightRequest="34"
                                                Padding="10,0" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <Label Text="Minutnik startuje sam po dodaniu kolejnej serii."
                                   FontSize="11"
                                   TextColor="{DynamicResource OnHeroSubtle}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- PODSUMOWANIE -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    Padding="18">
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="12"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            StrokeThickness="0"
                            Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Liczba serii"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label Text="{Binding Sets.Count}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            StrokeThickness="0"
                            Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Szac. 1RM"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label Text="{Binding CurrentOneRepMaxText}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Green}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.ColumnSpan="2"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            StrokeThickness="0"
                            Padding="14">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Objętość (kg × powt.):"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CurrentVolumeText}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </Grid>
            </Border>

            <!-- SESJA: ZAPISANE ĆWICZENIA -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource GreenSoft}"
                    Stroke="{DynamicResource GreenBorder}"
                    StrokeThickness="1"
                    Padding="16"
                    IsVisible="{Binding HasSessionExercises}">
                <VerticalStackLayout Spacing="6">
                    <Label
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource GreenText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="&#xe86c;" FontFamily="MaterialSymbols" />
                                <Span Text="  Zapisane w tej sesji" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SessionExercises}"
                                         Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}"
                                       FontSize="13"
                                       TextColor="{DynamicResource GreenText}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- TOOLKIT: SZYBKA POMOC -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource OrangeSoft}"
                            Stroke="{DynamicResource OrangeBorder}"
                            StrokeThickness="1"
                            Padding="16">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="&#xe0f0;"
                                   FontSize="18"
                                   VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="Wskazówka treningowa"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource OrangeText}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </toolkit:Expander.Header>

                <Border StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource OrangeBorder}"
                        StrokeThickness="1"
                        Padding="16"
                        Margin="0,8,0,0">
                    <Label Text="Po zapisaniu możesz później edytować trening z poziomu historii. Jeśli dodałeś za dużo serii, usuń je ikoną po prawej stronie."
                           FontSize="14"
                           TextColor="{DynamicResource OrangeText}" />
                </Border>
            </toolkit:Expander>

            <!-- PRZYCISK: ZAPISZ I DODAJ KOLEJNE -->
            <Button Text="Zapisz i dodaj kolejne ćwiczenie"
                    Command="{Binding SaveAndContinueCommand}"
                    BackgroundColor="{DynamicResource Surface}"
                    TextColor="{DynamicResource TextPrimary}"
                    BorderColor="{DynamicResource TextPrimary}"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    FontSize="14" />

            <!-- PRZYCISK ZAPISU -->
            <Button Text="Zapisz i zakończ"
                    Command="{Binding SaveWorkoutCommand}"
                    BackgroundColor="{DynamicResource PrimaryButton}"
                    TextColor="{DynamicResource OnPrimaryButton}"
                    CornerRadius="12"
                    HeightRequest="56"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,4,0,20">
                <Button.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.3" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>