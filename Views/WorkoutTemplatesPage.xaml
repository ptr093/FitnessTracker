<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.WorkoutTemplatesPage"
             Title="Szablony treningów">

    <Grid RowDefinitions="Auto,*"
          MaximumWidthRequest="620">

        <controls:PageHeader Grid.Row="0"
                             Margin="15,20,15,12"
                             Title="Szablony treningów"
                             Subtitle="Uruchamiaj gotowe treningi szybciej."
                             BackgroundKey="TealStrong">
            <controls:PageHeader.TrailingContent>
                <Button Text="+ Nowy"
                        Command="{Binding AddTemplateCommand}"
                        BackgroundColor="White"
                        TextColor="#0F766E"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        Padding="14,0" />
            </controls:PageHeader.TrailingContent>
        </controls:PageHeader>

        <RefreshView Grid.Row="1"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{DynamicResource Teal}">

            <CollectionView ItemsSource="{Binding Templates}"
                            SelectionMode="None"
                            Margin="15,0,15,20">

                <CollectionView.EmptyView>
                    <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                         Padding="28"
                                         Spacing="10"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">

                        <Label Text="&#xe85d;"
                               FontSize="44"
                               HorizontalTextAlignment="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />

                        <Label Text="Nie masz jeszcze szablonów"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Utwórz np. „Trening klaty” i dodaj do niego swoje ćwiczenia."
                               FontSize="13"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />

                        <Button Text="+ Utwórz pierwszy szablon"
                                Command="{Binding AddTemplateCommand}"
                                BackgroundColor="{DynamicResource TealStrong}"
                                TextColor="{DynamicResource OnHero}"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="46"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource Border}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18">

                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}"
                                               LineBreakMode="TailTruncation" />

                                        <Label Text="{Binding Subtitle}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextMuted}" />

                                        <Label Text="{Binding Description}"
                                               IsVisible="{Binding HasDescription}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="&#xe85d;"
                                           FontSize="28"
                                           VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="9">

                                    <Button Text="Rozpocznij"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.StartTemplateCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{DynamicResource TealStrong}"
                                            TextColor="{DynamicResource OnHero}"
                                            FontAttributes="Bold"
                                            CornerRadius="12"
                                            HeightRequest="42" />

                                    <Button Grid.Column="1"
                                            Text="Edytuj"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.EditTemplateCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{DynamicResource BlueSoft}"
                                            TextColor="{DynamicResource Blue}"
                                            FontAttributes="Bold"
                                            CornerRadius="12"
                                            HeightRequest="42"
                                            Padding="14,0" />

                                    <Button Grid.Column="2"
                                            Text="Usuń"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.DeleteTemplateCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{DynamicResource RedSoft}"
                                            TextColor="{DynamicResource Red}"
                                            FontAttributes="Bold"
                                            CornerRadius="12"
                                            HeightRequest="42"
                                            Padding="14,0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>