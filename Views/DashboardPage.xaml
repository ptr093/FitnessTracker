<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessTracker.Views.DashboardPage"
             Title="Witaj w Treningu!"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="15,24,15,35"
                             Spacing="16"
                             MaximumWidthRequest="620"
                             HorizontalOptions="Center">

            <Label Text="Wybierz akcję"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#1E293B"
                   Margin="0,0,0,4" />

            <!-- TRENING SIŁOWY -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#0F172A"
                    StrokeThickness="0"
                    MinimumHeightRequest="112"
                    Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToGymCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Label Text="🏋️"
                           FontSize="34"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Trening Siłowy"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Rejestruj serie i powtórzenia"
                               FontSize="12"
                               TextColor="#94A3B8"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- MOJE ĆWICZENIA -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#F8FAFC"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    MinimumHeightRequest="112"
                    Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToManageExercisesCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Label Text="🛠️"
                           FontSize="34"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Moje ćwiczenia"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />
                        <Label Text="Edytuj i usuwaj własne ćwiczenia"
                               FontSize="12"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- SZABLONY TRENINGÓW -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#F0FDFA"
                    Stroke="#99F6E4"
                    StrokeThickness="1"
                    MinimumHeightRequest="132"
                    Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToWorkoutTemplatesCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      VerticalOptions="Center">
                    <Label Text="📋"
                           FontSize="32"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="3"
                                         VerticalOptions="Center">
                        <Label Text="Szablony treningów"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#115E59"
                               LineBreakMode="WordWrap" />
                        <Label Text="Uruchom gotowy plan jednym kliknięciem"
                               FontSize="12"
                               TextColor="#0F766E"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- BIEGANIE -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#064E3B"
                    StrokeThickness="0"
                    MinimumHeightRequest="112"
                    Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToRunCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Label Text="🏃"
                           FontSize="34"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Bieganie"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Dystans, czas i międzyczasy"
                               FontSize="12"
                               TextColor="#D1FAE5"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- HISTORIA -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    MinimumHeightRequest="112"
                    Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToHistoryCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Label Text="📅"
                           FontSize="34"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Historia treningów"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#1E293B" />
                        <Label Text="Przeglądaj swoje postępy"
                               FontSize="12"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- REKORDY -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#FFF7ED"
                    Stroke="#FED7AA"
                    StrokeThickness="1"
                    MinimumHeightRequest="112"
                    Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToRecordsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Label Text="🏆"
                           FontSize="34"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Rekordy"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#9A3412" />
                        <Label Text="Najlepsze wyniki i postęp"
                               FontSize="12"
                               TextColor="#C2410C"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ANALITYKA -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#EEF2FF"
                    Stroke="#C7D2FE"
                    StrokeThickness="1"
                    MinimumHeightRequest="112"
                    Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToStatsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Label Text="📊"
                           FontSize="34"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="Analityka i Wilks"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#3730A3" />
                        <Label Text="Sprawdź BMI i współczynnik siły"
                               FontSize="12"
                               TextColor="#4F46E5"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- STRAVA -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#F8FAFC"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="20"
                    Margin="0,4,0,0">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="⌚"
                               FontSize="18"
                               VerticalOptions="Center" />
                        <Label Text="Synchronizacja Strava"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Pobierz swoje najnowsze aktywności biegowe bezpośrednio z zewnętrznego konta."
                           FontSize="13"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                    <Button Text="{Binding SyncButtonText}"
                            Command="{Binding SyncApiWorkoutsCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            IsEnabled="{Binding IsNotSyncing}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
