<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:FitnessTracker.Controls"
             x:Class="FitnessTracker.Views.RunWorkoutPage"
             Title="Bieganie">

    <ScrollView>
        <VerticalStackLayout Padding="15,20"
                             Spacing="18"
                             MaximumWidthRequest="620"
                             HorizontalOptions="Fill">

            <controls:PageHeader Title="Bieganie"
                                 Subtitle="Dystans, czas i międzyczasy na kilometr."
                                 BackgroundKey="HeroRun" />

            <!-- KARTA: SZCZEGÓŁY BIEGU -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Padding="20"
                                     Spacing="16">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xe566;"
                               FontSize="18"
                               VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Szczegóły biegu"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="6">
                            <Label Text="Dystans (km)"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"
                                   FontAttributes="Bold"
                                   TextTransform="Uppercase" />

                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="1">
                                <Grid Padding="12,0">
                                    <Entry Text="{Binding RunDistance}"
                                           Keyboard="Numeric"
                                           Placeholder="Np. 5"
                                           PlaceholderColor="{DynamicResource Placeholder}"
                                           TextColor="{DynamicResource TextPrimary}"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           BackgroundColor="Transparent"
                                           HeightRequest="48" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">
                            <Label Text="Czas (min)"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}"
                                   FontAttributes="Bold"
                                   TextTransform="Uppercase" />

                            <Border StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource SurfaceMuted}"
                                    Stroke="{DynamicResource Border}"
                                    StrokeThickness="1">
                                <Grid Padding="12,0">
                                    <Entry Text="{Binding RunTime}"
                                           Keyboard="Numeric"
                                           Placeholder="Np. 26"
                                           PlaceholderColor="{DynamicResource Placeholder}"
                                           TextColor="{DynamicResource TextPrimary}"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           BackgroundColor="Transparent"
                                           HeightRequest="48" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- KARTA: MIĘDZYCZASY -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Padding="20"
                                     Spacing="14">

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xe425;"
                               FontSize="18"
                               VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                        <Label Text="Międzyczasy"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="60,*,50"
                          ColumnSpacing="8"
                          Margin="0,0,0,4">
                        <Label Grid.Column="0"
                               Text="KM"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />

                        <Label Grid.Column="1"
                               Text="TEMPO"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalTextAlignment="Center" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Splits}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{DynamicResource SurfaceMuted}"
                                        Stroke="{DynamicResource Border}"
                                        StrokeThickness="1"
                                        Padding="10">

                                    <Grid ColumnDefinitions="60,*,50"
                                          ColumnSpacing="8">

                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource GreenSoft}"
                                                StrokeThickness="0"
                                                HeightRequest="42"
                                                WidthRequest="50"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Kilometer}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource GreenText}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Surface}"
                                                Stroke="{DynamicResource BorderStrong}"
                                                StrokeThickness="1">
                                            <Grid Padding="12,0">
                                                <Entry Text="{Binding Pace}"
                                                       Placeholder="Np. 4:45"
                                                       PlaceholderColor="{DynamicResource Placeholder}"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       BackgroundColor="Transparent"
                                                       HeightRequest="42" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                BackgroundColor="{DynamicResource RedSoft}"
                                                Stroke="{DynamicResource RedBorder}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="1"
                                                HeightRequest="42"
                                                WidthRequest="42"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Button Text="&#xe5cd;"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource Red}"
                                                    BackgroundColor="Transparent"
                                                    Padding="0"
                                                    CornerRadius="10"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSplitCommand}"
                                                    CommandParameter="{Binding .}" FontFamily="MaterialSymbols" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="+ Dodaj kilometr"
                            Command="{Binding AddSplitCommand}"
                            BackgroundColor="{DynamicResource GreenSoft}"
                            TextColor="{DynamicResource Green}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- PODSUMOWANIE -->
            <Border StrokeShape="RoundRectangle 18"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    Padding="18">
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            StrokeThickness="0"
                            Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Liczba splitów"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label Text="{Binding Splits.Count}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource SurfaceMuted}"
                            StrokeThickness="0"
                            Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Status"
                                   FontSize="12"
                                   TextColor="{DynamicResource TextMuted}" />
                            <Label Text="Gotowe do zapisu"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Green}" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </Border>

            <!-- TOOLKIT: WSKAZÓWKA -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{DynamicResource GreenSoft}"
                            Stroke="{DynamicResource GreenBorder}"
                            StrokeThickness="1"
                            Padding="16">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="&#xe0f0;"
                                   FontSize="18"
                                   VerticalOptions="Center" FontFamily="MaterialSymbols" TextColor="{DynamicResource TextSecondary}" />
                            <Label Text="Wskazówka biegowa"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource GreenText}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </toolkit:Expander.Header>

                <Border StrokeShape="RoundRectangle 14"
                        BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource GreenBorder}"
                        StrokeThickness="1"
                        Padding="16"
                        Margin="0,8,0,0">
                    <Label Text="Po zapisaniu możesz później edytować bieg w historii. Wpisuj tempo na kilometr w formacie np. 4:45, żeby było czytelnie przy analizie."
                           FontSize="14"
                           TextColor="{DynamicResource GreenText}" />
                </Border>
            </toolkit:Expander>

            <!-- PRZYCISK ZAPISU -->
            <Button Text="Zapisz bieg"
                    Command="{Binding SaveWorkoutCommand}"
                    BackgroundColor="{DynamicResource HeroRun}"
                    TextColor="{DynamicResource OnHero}"
                    CornerRadius="12"
                    HeightRequest="56"
                    FontAttributes="Bold"
                    FontSize="16"
                    Margin="0,4,0,20">
                <Button.Shadow>
                    <Shadow Brush="{DynamicResource Shadow}"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.3" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>